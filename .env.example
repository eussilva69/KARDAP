NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Somente servidor. Gere uma service account no Firebase Console e nunca exponha estes valores no navegador.
# Opção 1 (recomendada): cole o JSON INTEIRO baixado do Firebase numa variável só.
# FIREBASE_ADMIN_CREDENTIALS='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...",...}'
# Opção 2: os três campos separados (compatibilidade com configurações antigas).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Login único (SSO) — SSO_INTEGRATION.md. Os valores abaixo já são os padrões de produção.
SSO_COOKIE_DOMAIN=.kardapp.online
SSO_COOKIE_NAME=kardap_sso_session
SSO_SESSION_MAX_AGE=432000
SSO_ALLOWED_ORIGINS=https://kardapp.online,https://www.kardapp.online,https://pdv.kardapp.online
# Segredo do PDV (somente servidor, 32+ caracteres; o mesmo valor vai em SSO_CLIENT_SECRET no PDV).
# Gere com: openssl rand -base64 48
SSO_CLIENT_SECRET_PDV=
# Opcional: chave dos códigos de uso único (32+ caracteres). Sem ela, é derivada de FIREBASE_ADMIN_PRIVATE_KEY.
# SSO_SIGNING_SECRET=

# Cobrança (Cakto) — docs/PLANOS.md. Somente servidor.
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
# Obrigatório: sem ele o webhook recusa todos os eventos (nenhum plano é ativado sem confirmação autêntica).
CAKTO_WEBHOOK_SECRET=
# Ofertas MENSAIS dos planos atuais (Start R$ 49,90, Pro R$ 129,90, Business R$ 199,90). Sem a oferta, o plano não
# abre checkout. O Enterprise não tem oferta: é contratado com o time comercial.
CAKTO_OFFER_START=
CAKTO_OFFER_PRO=
CAKTO_OFFER_BUSINESS=
# Ofertas dos planos anteriores (Essencial e Pro antigo): só para reconhecer renovações de quem já assina.
CAKTO_OFFER_ESSENCIAL_MONTHLY=
CAKTO_OFFER_ESSENCIAL_ANNUAL=
CAKTO_OFFER_PRO_MONTHLY=
CAKTO_OFFER_PRO_ANNUAL=

# Google Maps Platform — somente servidor (autocomplete de cidades/endereços no delivery). Ative na chave:
# Places API (New) e Geocoding API; restrinja a chave por API. GOOGLE_PLACES_API_KEY continua aceita.
GOOGLE_MAPS_API_KEY=
