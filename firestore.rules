rules_version = '2';

// ATENÇÃO: estas são as regras restritivas propostas, AINDA NÃO PUBLICADAS.
// Em produção, por decisão do responsável (riscos assumidos), vale esta regra aberta:
//   match /{document=**} { allow read, write: if true; }
// Enquanto ela estiver ativa, nenhuma proteção abaixo (admins, assinatura, suspensão, membros)
// é imposta pelo servidor; /admin e os limites de plano só são checados no app.
// Para adotar este arquivo: teste no emulador e rode `firebase deploy --only firestore:rules`.

// Regras do Kardap.
// Princípios:
//  - O cardápio público precisa ler restaurante, configurações, categorias, produtos e mesas sem login.
//  - Só a equipe do restaurante (documento em membros/{uid}) altera os dados do restaurante.
//  - Dono, plano, situação e assinatura só mudam pelo servidor (Admin SDK) ou por um administrador do sistema.
//  - Administradores do sistema são definidos por documentos admins/{uid}, criados pelo console ou por
//    scripts/grant-admin.mjs. Nenhum cliente consegue se promover a administrador.
//  - Tudo o que não está listado aqui é negado.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Identidade anônima: criada no cardápio público na primeira curtida (sem cadastro).
    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function restaurantPath(restaurantId) {
      return /databases/$(database)/documents/restaurantes/$(restaurantId);
    }

    function isMember(restaurantId) {
      return signedIn() && exists(/databases/$(database)/documents/restaurantes/$(restaurantId)/membros/$(request.auth.uid));
    }

    // Dono do restaurante considerando o estado depois da escrita: cobre o lote que cria
    // restaurante, membro e configurações de uma vez.
    function ownsAfter(restaurantId) {
      return signedIn() && getAfter(restaurantPath(restaurantId)).data.ownerId == request.auth.uid;
    }

    // Campos que o painel do restaurante não pode alterar.
    function touchesProtectedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['ownerId', 'subscription', 'status', 'suspendedAt', 'suspendedReason']);
    }

    // ───── Administração do sistema ─────

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /adminLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Perfil criado pelo servidor no cadastro.
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Reserva de endereço do cardápio (/r/:slug), feita em transação na configuração inicial.
    match /menuSlugs/{slug} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['restaurantId', 'createdAt'])
        && get(restaurantPath(request.resource.data.restaurantId)).data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Login único (SSO_INTEGRATION.md): sessões (id = hash do cookie) e códigos de uso único já trocados.
    // Só o servidor central (Admin SDK) usa.
    match /ssoSessoes/{sessionId} {
      allow read, write: if false;
    }
    match /ssoCodigosUsados/{codeId} {
      allow read, write: if false;
    }

    // ───── Planos e cobrança (docs/PLANOS.md) ─────
    // Catálogo publicado pelo servidor (cópia do catálogo do código, para consulta).
    match /planos/{planId} {
      allow read: if true;
      allow write: if false;
    }
    // Checkout, eventos do webhook, falhas de sincronização e propostas Enterprise: só o servidor grava.
    match /cakto_checkout_sessions/{token} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cakto_webhook_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /falhasSincronizacao/{failureId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /propostasEnterprise/{proposalId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ───── Clientes do cardápio (Reels, docs/REELS.md) ─────
    // Conta de cliente: serve só para guardar pratos salvos. Cada pessoa lê e grava apenas o que é dela;
    // a identidade anônima (de quem só curtiu) não grava aqui.
    match /clientes/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && !isAnonymous()
        && request.resource.data.keys().hasOnly(['tipo', 'email', 'atualizadoEm'])
        && request.resource.data.tipo == 'cliente'
        && request.resource.data.atualizadoEm == request.time;

      match /salvos/{saveId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && !isAnonymous()
          && request.resource.data.keys().hasOnly(['restaurantId', 'restaurantSlug', 'restaurantName', 'productId', 'name', 'priceCents', 'image', 'savedAt'])
          && request.resource.data.restaurantId is string
          && request.resource.data.productId is string
          && saveId == request.resource.data.restaurantId + '_' + request.resource.data.productId
          && request.resource.data.restaurantSlug is string && request.resource.data.restaurantSlug.size() <= 120
          && request.resource.data.restaurantName is string && request.resource.data.restaurantName.size() <= 200
          && request.resource.data.name is string && request.resource.data.name.size() <= 200
          && request.resource.data.image is string && request.resource.data.image.size() <= 2048
          && request.resource.data.priceCents is int
          && request.resource.data.savedAt is int;
      }
    }

    // ───── Restaurantes ─────

    match /restaurantes/{restaurantId} {
      // Público: o cardápio encontra o restaurante pelo slug.
      allow read: if true;
      // Quem cria é o próprio dono, sem assinatura e com situação ativa.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && !request.resource.data.keys().hasAny(['subscription', 'suspendedAt', 'suspendedReason'])
        && request.resource.data.get('status', 'active') == 'active';
      allow update: if isAdmin()
        || ((isMember(restaurantId) || resource.data.ownerId == request.auth.uid) && !touchesProtectedFields());
      allow delete: if isAdmin();

      match /membros/{memberId} {
        allow read: if isMember(restaurantId) || isAdmin() || (signedIn() && request.auth.uid == memberId);
        // O dono cria o próprio registro no mesmo lote do restaurante; depois, só o dono gerencia a equipe.
        allow create: if isAdmin() || ownsAfter(restaurantId);
        allow update, delete: if isAdmin() || ownsAfter(restaurantId);
      }

      match /configuracoes/{configId} {
        allow read: if true;
        allow write: if isAdmin() || isMember(restaurantId) || ownsAfter(restaurantId);
      }

      // O vídeo publicado (videoUrl, videoPoster, video) é gravado só pelo worker de vídeo, com
      // credencial de servidor (que não passa por estas regras). O painel pode apenas removê-lo.
      function videoFieldsUntouchedOrCleared() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny(['videoUrl', 'videoPoster', 'video'])
          || (request.resource.data.get('videoUrl', '') == ''
            && request.resource.data.get('videoPoster', '') == ''
            && request.resource.data.get('video', null) == null);
      }

      // Curtidas dos Reels: uma por pessoa e prato (id = produto_uid). A curtida e o contador `likes` do
      // produto mudam no mesmo lote (+1 ao criar, −1 ao apagar); uma sem a outra é recusada.
      function productPath(productId) {
        return /databases/$(database)/documents/restaurantes/$(restaurantId)/produtos/$(productId);
      }
      function myLikePath(productId) {
        return /databases/$(database)/documents/restaurantes/$(restaurantId)/curtidas/$(productId + '_' + request.auth.uid);
      }

      // Contador de curtidas: quem curte soma 1 (ou subtrai, ao descurtir), sempre junto com a própria curtida.
      function likeCounterUpdate(productId) {
        let before = resource.data.get('likes', 0);
        let after = request.resource.data.get('likes', 0);
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && after is int
          && ((after == before + 1 && !exists(myLikePath(productId)) && existsAfter(myLikePath(productId)))
            || (after == before - 1 && exists(myLikePath(productId)) && !existsAfter(myLikePath(productId))));
      }

      // O painel não altera o contador (ele reflete só curtidas reais).
      function likesUntouched() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes']);
      }

      match /produtos/{productId} {
        allow read: if true;
        allow create: if isAdmin() || (isMember(restaurantId)
          && request.resource.data.get('videoUrl', '') == ''
          && !request.resource.data.keys().hasAny(['videoPoster', 'video', 'likes']));
        allow update: if isAdmin()
          || (isMember(restaurantId) && videoFieldsUntouchedOrCleared() && likesUntouched())
          || likeCounterUpdate(productId);
        allow delete: if isMember(restaurantId) || isAdmin();
      }

      match /curtidas/{likeId} {
        // Cada pessoa vê só as próprias curtidas (para pintar o coração); o total fica no produto.
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['productId', 'uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.productId is string
          && likeId == request.resource.data.productId + '_' + request.auth.uid
          && request.resource.data.createdAt == request.time
          && exists(productPath(request.resource.data.productId))
          && getAfter(productPath(request.resource.data.productId)).data.get('likes', 0)
            == get(productPath(request.resource.data.productId)).data.get('likes', 0) + 1;
        allow delete: if signedIn()
          && resource.data.uid == request.auth.uid
          && getAfter(productPath(resource.data.productId)).data.get('likes', 0)
            == get(productPath(resource.data.productId)).data.get('likes', 0) - 1;
        allow update: if false;
      }

      // Registros de vídeo de produto (services/video-worker/src/contract.ts).
      // O painel cria o registro antes de enviar o arquivo e só pode: marcar o envio como concluído,
      // cancelar ou registrar falha de envio. processing, retrying e ready são exclusivos do worker.
      function clientVideoUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let from = resource.data.status;
        let to = request.resource.data.status;
        return changed.hasOnly(['status', 'error', 'uploadCompletedAt', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (
            (from in ['pending', 'uploading'] && to in ['pending', 'uploading'] && !changed.hasAny(['error']))
            || (from in ['pending', 'uploading', 'processing', 'retrying'] && to == 'canceled' && !changed.hasAny(['error']))
            || (from in ['pending', 'uploading'] && to == 'failed' && request.resource.data.error == 'upload')
          );
      }

      match /videos/{videoId} {
        allow read: if isMember(restaurantId) || isAdmin();
        allow create: if isMember(restaurantId)
          && request.resource.data.keys().hasOnly(['productId', 'status', 'originalPath', 'originalSize', 'contentType', 'fileName', 'createdBy', 'createdAt', 'updatedAt'])
          && request.resource.data.status in ['pending', 'uploading']
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.productId is string
          && exists(/databases/$(database)/documents/restaurantes/$(restaurantId)/produtos/$(request.resource.data.productId))
          && request.resource.data.originalPath == 'restaurantes/' + restaurantId + '/produtos/' + request.resource.data.productId + '/videos/original/' + videoId + '.' + request.resource.data.originalPath.split('[.]')[1]
          && request.resource.data.originalPath.matches('.*[.](mp4|mov|webm)')
          && request.resource.data.originalSize is int
          && request.resource.data.originalSize > 0
          && request.resource.data.originalSize <= 209715200
          && request.resource.data.contentType in ['video/mp4', 'video/quicktime', 'video/webm']
          && request.resource.data.fileName is string
          && request.resource.data.fileName.size() <= 120;
        allow update: if isAdmin() || (isMember(restaurantId) && clientVideoUpdate());
        allow delete: if isAdmin() || (isMember(restaurantId) && resource.data.status in ['ready', 'failed', 'canceled']);
      }

      match /categorias/{categoryId} {
        allow read: if true;
        allow write: if isMember(restaurantId) || isAdmin();
      }

      // Mesas: criadas só pelo servidor (POST /api/restaurants/{id}/mesas), que confere o limite do plano na mesma
      // transação. A equipe renomeia, muda a situação e exclui; número e QR Code não mudam pelo navegador.
      match /mesas/{tableId} {
        allow read: if true;
        allow create: if isAdmin();
        allow update: if isAdmin() || (isMember(restaurantId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'status', 'capacity', 'updatedAt']));
        allow delete: if isMember(restaurantId) || isAdmin();
      }

      // Pedidos (docs/PLANOS.md). Rascunhos podem ser gravados pela equipe; a confirmação de pedido próprio (que
      // consome a franquia) e os pedidos de marketplace passam pelo servidor, que grava a origem e o consumo.
      // Origem, consumo e confirmação nunca mudam pelo navegador.
      function orderProtectedFields() {
        return ['origin', 'quota', 'confirmedAt', 'confirmedBy', 'establishmentId', 'isNativeOrder', 'source'];
      }
      match /pedidos/{orderId} {
        allow read: if isMember(restaurantId) || isAdmin();
        allow create: if isMember(restaurantId)
          && request.resource.data.get('status', '') == 'rascunho'
          && !request.resource.data.keys().hasAny(orderProtectedFields());
        allow update: if isAdmin() || (isMember(restaurantId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(orderProtectedFields())
          // Rascunho só vira pedido pelo servidor (confirmação).
          && (resource.data.get('status', '') != 'rascunho' || request.resource.data.get('status', '') == 'rascunho'));
        allow delete: if isAdmin() || (isMember(restaurantId) && resource.data.get('status', '') == 'rascunho');
      }

      // Consumo mensal (uso/{AAAA-MM}) e trilhas de auditoria: só o servidor grava.
      match /uso/{periodId} {
        allow read: if isMember(restaurantId) || isAdmin();
        allow write: if false;
      }
      match /eventosUso/{eventId} {
        allow read: if isMember(restaurantId) || isAdmin();
        allow write: if false;
      }
      match /eventosAssinatura/{eventId} {
        allow read: if isMember(restaurantId) || isAdmin();
        allow write: if false;
      }

      match /chamados/{chamadoId} {
        // O cliente na mesa cria o chamado sem login, só com os campos esperados.
        allow create: if request.resource.data.keys().hasOnly(['table', 'type', 'status', 'createdAt'])
          && request.resource.data.status == 'ativo'
          && request.resource.data.table is string && request.resource.data.table.size() <= 60
          && request.resource.data.type is string && request.resource.data.type.size() <= 120
          && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
        allow read, update, delete: if isMember(restaurantId) || isAdmin();
      }

      // Histórico de cobranças e dados do cartão: escritos só pelo servidor.
      match /pagamentos/{paymentId} {
        allow read: if isMember(restaurantId) || isAdmin();
        allow write: if false;
      }

      match /privado/{docId} {
        allow read: if isMember(restaurantId) || isAdmin();
        allow write: if false;
      }

      match /assinaturas/{subId} {
        allow read: if isMember(restaurantId) || isAdmin();
        allow write: if false;
      }
    }
  }
}
