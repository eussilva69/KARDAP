# PDV (pdv.kardapp.online) — variáveis do login único com o servidor central (kardapp.online).
# Contrato completo: SSO_INTEGRATION.md no repositório do KARDAP.

# Firebase do navegador: os MESMOS valores do KARDAP (mesmo projeto, mesmo Firebase Auth, mesmos UIDs).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Somente servidor (nunca NEXT_PUBLIC_). O mesmo valor de SSO_CLIENT_SECRET_PDV no KARDAP (32+ caracteres).
# O PDV NÃO precisa de credencial do Firebase Admin para o login.
SSO_CLIENT_ID=pdv
SSO_CLIENT_SECRET=

# Opcionais: em produção os padrões já são estes.
# SSO_COOKIE_NAME=kardap_sso_session
# SSO_COOKIE_DOMAIN=.kardapp.online
# SSO_ALLOWED_ORIGINS=https://kardapp.online,https://www.kardapp.online,https://pdv.kardapp.online
# NEXT_PUBLIC_KARDAP_ORIGIN=https://kardapp.online
# NEXT_PUBLIC_PDV_ORIGIN=https://pdv.kardapp.online
# Endereço do servidor central usado pelo servidor do PDV (ex.: rede interna). Padrão: NEXT_PUBLIC_KARDAP_ORIGIN.
# SSO_CENTRAL_URL=https://kardapp.online
